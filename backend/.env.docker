# Backend services environment for docker-compose
MONGODB_CONNECTION_STRING=mongodb://mongo:27017/hotel-booking
FRONTEND_URL=http://localhost:4173
JWT_SECRET_KEY=supersecretkey
ALLOW_ROLE_FROM_REGISTER=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
VERIFICATION_CODE_TTL_MINUTES=15
REQUIRE_VERIFIED_EMAIL_FOR_LOGIN=false
LOYALTY_POINTS_PER_CURRENCY=0.1

# Service-to-service auth
INTERNAL_SERVICE_API_KEY=supersecretinternalapikey
NOTIFICATION_SERVICE_KEY=supersecretinternalapikey

# Asgardeo (OIDC) configuration – replace with your tenant + SPA client
ASGARDEO_TENANT_DOMAIN=theenukagranex
ASGARDEO_ORG_URL=https://api.asgardeo.io/t/theenukagranex
ASGARDEO_CLIENT_ID=iYcA_MO8LwTND_hvunAg8VvBHDua
ASGARDEO_AUDIENCE=
ASGARDEO_ISSUER=https://api.asgardeo.io/t/theenukagranex/oauth2/token
ASGARDEO_JWKS_URL=https://api.asgardeo.io/t/theenukagranex/oauth2/jwks

# Optional: Stripe (not required for local dev)
STRIPE_API_KEY=

# Notification delivery
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=theenukabandara@gmail.com
NOTIFICATION_FROM_NAME=Phoenix Booking
REDIS_URL=redis://redis:6379/0
NOTIFICATION_QUEUE_MODE=inline
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Service URLs
NOTIFICATION_SERVICE_URL=http://notification-service:7101
IDENTITY_SERVICE_URL=http://identity-service:7102
HOTEL_SERVICE_URL=http://hotel-service:7103
BOOKING_SERVICE_URL=http://booking-service:7104
SEARCH_SERVICE_URL=http://search-service:7105

# Cloudinary (enable image uploads)
# Prefer single URL form (recommended):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>?secure=true
# Or set parts below if not using CLOUDINARY_URL
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=